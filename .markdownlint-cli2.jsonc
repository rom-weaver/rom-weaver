{
  "customRules": [
    "./scripts/markdownlint-no-soft-line-breaks.mjs"
  ],
  "globs": [
    "*.md",
    ".github/**/*.md",
    "crates/**/README.md",
    "design/**/README.md",
    "docs/**/*.md",
    "packages/**/README.md",
    "scripts/wasm/README.md"
  ],
  "ignores": [
    // `packages/**/README.md` otherwise matches every installed dependency's
    // README, so the lefthook `markdownlint` job fails on vendored upstream
    // markdown the moment a worktree has node_modules and any .md is staged.
    "**/node_modules/**",
    "CHANGELOG.md",
    "crates/rom-weaver-containers/libarchive/vendor/**/*.md",
    "packages/**/node_modules/**"
  ],
  "config": {
    "default": true,
    "MD012": false,
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD033": {
      "allowed_elements": [
        "a",
        "br",
        "code",
        "details",
        "figcaption",
        "figure",
        "h1",
        "img",
        "p",
        "picture",
        "source",
        "summary",
        "table",
        "tbody",
        "td",
        "th",
        "thead",
        "tr"
      ]
    },
    "MD041": false,
    "MD038": false,
    "MD051": false,
    "MD060": false
  },
  "overrides": [
    // These files contain model instructions, not project documentation.
    {
      "filter": [
        "AGENTS.md",
        "CLAUDE.md"
      ],
      "config": {
        "RW001": false
      },
      "combine": "merge"
    }
  ]
}
