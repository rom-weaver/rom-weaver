      "reason": "Cap each LZMA1/LZMA2 dictionary at the folder's output size on both the SDK and liblzma decode paths; no match reaches past the output, and a larger dictionary can exceed a 1 GiB WebAssembly memory.",
      "upstream": {
        "status": "local"
      },
      "tests": [
        "cargo test -p rom-weaver-cli --test cli_smoke extract_7z_with_a_dictionary_larger_than_the_address_space_limit",
        "cargo test -p rom-weaver-cli --test cli_smoke extract_7z_runs_only_as_many_folder_decoders_as_the_memory_limit_fits"
      ]
    },
