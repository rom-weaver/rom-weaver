      "reason": "Validate gzip member CRC32 and uncompressed size.",
      "upstream": {
        "status": "local"
      },
      "tests": [
        "cargo test -p rom-weaver-cli --test cli_smoke gzip_concatenated_members_validate_each_crc_and_size"
      ]
    },
