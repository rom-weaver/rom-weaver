      ]
    },
    {
      "file": "0011-archive_read_support_format_zip.patch",
      "stage": "source",
      "reason": "Accept a completed Zstd ZIP entry when the input frame is fully consumed.",
      "upstream": {
        "status": "local"
      },
      "tests": [
        "cargo test -p rom-weaver-cli --test cli_smoke zip_zstd_large_incompressible_payload_round_trips"
      ]
    },
