      "file": "0012-7zip_sdk_null_advance.patch",
      "stage": "build",
      "reason": "Avoid advancing a null SDK input pointer for zero input.",
      "upstream": {
        "status": "local"
      },
      "tests": ["cargo test -p rom-weaver-containers --lib seven_z_short_period_matches_round_trip"]
    },
    {
