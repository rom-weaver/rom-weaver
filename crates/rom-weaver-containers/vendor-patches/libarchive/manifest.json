      "stage": "build",
      "reason": "Complete gzip integrity validation at archive EOF.",
      "upstream": {
        "status": "local"
      },
      "tests": [
        "cargo test -p rom-weaver-cli --test cli_smoke padded_gzip_tar_validates_unread_members_before_emitting_output"
      ]
