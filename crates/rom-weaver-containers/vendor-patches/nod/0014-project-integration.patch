-            let mut guard = self.partition.lock().unwrap();
-            guard.seek(SeekFrom::Start(abs_pos)).map_err(io_err)?;
-            guard.read_exact(&mut buf).map_err(io_err)?;
-        }
-        self.pos += to_read as u64;
-        Ok(PyBytes::new(py, &buf))
