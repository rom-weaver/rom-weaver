-    /// `PyPartitionReader` that created us).
-    partition: Arc<Mutex<Box<dyn PartitionReader>>>,
-    /// Absolute byte offset of the file within the partition stream.
-    file_offset: u64,
-    /// File size in bytes.
-    file_size: u64,
-    /// Current read position relative to the start of the file.
-    pos: u64,
-    closed: bool,
-}
