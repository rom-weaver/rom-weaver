    {
      "file": "0019-dead-code-cleanup.patch",
      "stage": "integration",
      "reason": "Remove unused preloader fields, shutdown and commented-out thread tuning, unused NKit flags and a stale WIP comment; document the read-ahead floor and cache sizing.",
      "upstream": {
        "status": "project-specific",
        "url": "https://github.com/encounter/nod"
      },
      "tests": [
        "cargo test -p rom-weaver-containers --lib nod::"
      ]
    },
    {
      "file": "0020-test-hooks.patch",
      "stage": "integration",
      "reason": "Attach the project's nod unit-test modules and add inline WIA/RVZ header, disc and block-reader validation tests.",
      "upstream": {
        "status": "project-specific",
        "url": "https://github.com/encounter/nod"
      },
      "tests": [
        "cargo test -p rom-weaver-containers --lib",
        "cargo test -p rom-weaver-cli --test cli_smoke"
      ]
    }
