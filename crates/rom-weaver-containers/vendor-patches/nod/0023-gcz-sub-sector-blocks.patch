+/// Smallest GCZ block this reader accepts. Dolphin writes any power-of-two block size, but the
+/// block map costs 12 bytes per block, so anything below the 512 byte disc sector is rejected.
+const MIN_BLOCK_SIZE: u32 = 512;
+
+/// Block sizes are either whole sectors (any multiple of 32 KiB) or a power of two that divides a
+/// sector evenly, which dolphin-tool writes for sizes like 16 KiB down to 2 KiB.
+fn is_supported_block_size(block_size: u32) -> bool {
+    if block_size >= SECTOR_SIZE as u32 {
+        block_size % SECTOR_SIZE as u32 == 0
+    } else {
+        block_size >= MIN_BLOCK_SIZE && block_size.is_power_of_two()
+    }
+}
