{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rom-weaver save schema pack v1",
  "description": "Authoring shape. Runtime validation also checks bounds, overlap, IDs, value ranges, and total integrity work.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 1024
    },
    "schema_version": {
      "const": 1
    },
    "pack_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "records": {
      "type": "object",
      "maxProperties": 4096,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4096,
        "items": {
          "$ref": "#/$defs/field"
        }
      }
    },
    "games": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/game"
      },
      "minItems": 1
    }
  },
  "required": ["schema_version", "games"],
  "$defs": {
    "game": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "description": {
          "type": "string",
          "maxLength": 1024
        },
        "save_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "fields": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/flat_field"
          }
        },
        "records": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/record_instance"
          }
        },
        "signatures": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "checksums": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/checksum"
          }
        },
        "mirrors": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/mirror"
          }
        },
        "generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/generation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["id", "name", "platform", "save_size", "fields"]
    },
    "record_instance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "default": 1
        },
        "stride": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "stride_bits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "index_start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "default": 0
        },
        "index_width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 0
        }
      },
      "required": ["record", "offset", "id"],
      "allOf": [
        {
          "not": {
            "required": ["stride", "stride_bits"]
          }
        },
        {
          "if": {
            "required": ["count"],
            "properties": {
              "count": {
                "minimum": 2
              }
            }
          },
          "then": {
            "oneOf": [
              {
                "required": ["stride"]
              },
              {
                "required": ["stride_bits"]
              }
            ]
          }
        }
      ]
    },
    "flat_field": {
      "allOf": [
        {
          "$ref": "#/$defs/field"
        },
        {
          "properties": {
            "id": {
              "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$"
            }
          }
        }
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^(?:[A-Za-z0-9_-]|\\{index\\})+(?:\\.(?:[A-Za-z0-9_-]|\\{index\\})+)*$"
        },
        "label": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "description": {
          "type": "string",
          "maxLength": 1024
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "type": {
          "enum": [
            "u8",
            "u16_le",
            "u16_be",
            "u32_le",
            "u32_be",
            "i8",
            "i16_le",
            "i16_be",
            "i32_le",
            "i32_be",
            "bool",
            "bit",
            "ascii",
            "u24_le",
            "u24_be",
            "bcd_le",
            "bcd_be"
          ]
        },
        "bit": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 7
        },
        "length": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 255
        },
        "min": {
          "type": ["integer", "null"],
          "minimum": -2147483648,
          "maximum": 4294967295
        },
        "max": {
          "type": ["integer", "null"],
          "minimum": -2147483648,
          "maximum": 4294967295
        },
        "editable": {
          "type": ["boolean", "null"]
        },
        "inverted": {
          "type": "boolean"
        },
        "copies": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8388608
          }
        },
        "choices": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "mask": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "required": ["id", "label", "offset", "type"],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "bit"
              }
            }
          },
          "then": {
            "required": ["bit"],
            "properties": {
              "bit": {
                "type": "integer"
              }
            }
          },
          "else": {
            "properties": {
              "bit": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["ascii", "bcd_le", "bcd_be"]
              }
            }
          },
          "then": {
            "required": ["length"],
            "properties": {
              "length": {
                "type": "integer"
              }
            }
          },
          "else": {
            "properties": {
              "length": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["bit", "bool", "ascii"]
              }
            }
          },
          "then": {
            "properties": {
              "min": {
                "type": "null"
              },
              "max": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["bcd_le", "bcd_be"]
              }
            }
          },
          "then": {
            "properties": {
              "length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["bit", "bool"]
              }
            }
          },
          "else": {
            "properties": {
              "inverted": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "u8",
                  "u16_le",
                  "u16_be",
                  "u24_le",
                  "u24_be",
                  "u32_le",
                  "u32_be",
                  "i8",
                  "i16_le",
                  "i16_be",
                  "i32_le",
                  "i32_be",
                  "bcd_le",
                  "bcd_be"
                ]
              }
            }
          },
          "else": {
            "not": {
              "required": ["choices"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["u8", "u16_le", "u16_be", "u24_le", "u24_be", "u32_le", "u32_be"]
              }
            }
          },
          "else": {
            "not": {
              "required": ["mask"]
            }
          }
        }
      ]
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!raw:).+"
        },
        "value": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        }
      },
      "required": ["name", "value"]
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "bytes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8388608,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      },
      "required": ["offset", "bytes"]
    },
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "enum": [
            "sum8",
            "sum16_le",
            "crc16_ccitt_false_le",
            "sum16_be",
            "sum32_le",
            "sum32_be",
            "add8",
            "add16_le",
            "add16_be",
            "add32_le",
            "add32_be",
            "xor8",
            "xor16_le",
            "xor16_be",
            "xor32_le",
            "xor32_be",
            "sum8_mod255_complement"
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "target": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 4294967295
        },
        "unit": {
          "enum": ["u8", "u16_le", "u16_be", "u32_le", "u32_be"]
        },
        "exclude": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/exclusion"
          }
        },
        "spans": {
          "type": "array",
          "maxItems": 4096,
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/checksum_span"
          }
        }
      },
      "required": ["algorithm", "offset"],
      "allOf": [
        {
          "if": {
            "properties": {
              "algorithm": {
                "enum": ["crc16_ccitt_false_le", "sum8_mod255_complement"]
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "type": "null"
              },
              "unit": {
                "const": "u8"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "enum": ["sum8", "add8", "xor8"]
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "maximum": 255
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "enum": ["sum16_le", "sum16_be", "add16_le", "add16_be", "xor16_le", "xor16_be"]
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "maximum": 65535
              }
            }
          }
        }
      ],
      "oneOf": [
        {
          "required": ["start", "length"],
          "not": {
            "required": ["spans"]
          }
        },
        {
          "required": ["spans"],
          "not": {
            "anyOf": [
              {
                "required": ["start"]
              },
              {
                "required": ["length"]
              }
            ]
          }
        }
      ]
    },
    "mirror": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "target": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "validate": {
          "type": ["boolean", "null"],
          "default": true
        }
      },
      "required": ["source", "target", "length"]
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fill": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "patches": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/span"
          }
        }
      },
      "required": ["fill"]
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      },
      "required": ["offset", "length"]
    },
    "checksum_span": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      },
      "required": ["start", "length"]
    }
  }
}
