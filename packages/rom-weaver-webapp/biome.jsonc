{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "root": true,
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedAttributes": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on",
      },
    },
    "enabled": true,
  },
  "files": {
    // Keep Biome on .css files; oxfmt owns HTML, including the app entry and
    // diagnostic pages. Exclude HTML here because overrides do not reach embedded CSS.
    "includes": ["**", "!**/*.html"],
    "ignoreUnknown": true,
  },
  // Biome formats CSS only; oxfmt owns JS/TS/JSON. Disabling the other
  // languages here is what lets `npm run format:css` take a plain `.` path -
  // Biome ignores glob arguments, so the config is the only place the CSS
  // scope can be expressed.
  "css": {
    "formatter": {
      "enabled": true,
      "quoteStyle": "double",
    },
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 120,
  },
  "javascript": {
    "formatter": {
      "enabled": false,
    },
  },
  "json": {
    "formatter": {
      "enabled": false,
    },
  },
  "linter": {
    "domains": {
      "react": "recommended",
    },
    "enabled": true,
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn",
        "noForEach": "error",
        // Reduced-motion resets, inline styles, and later cascade layers need
        // targeted !important overrides. Check layer conflicts with lint:css-layers.
        "noImportantStyles": "off",
        "noUselessStringConcat": "error",
        "useSimplifiedLogicExpression": "error",
      },
      "performance": {
        "useTopLevelRegex": "off",
      },
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "error",
      },
      "nursery": {
        "noDuplicateSelectors": "error",
      },
      "style": {
        "noCommonJs": "error",
        // This rule reports unrelated icon selectors that all end in svg.
        // lint:css-layers checks conflicts across the app's cascade layers.
        "noDescendingSpecificity": "off",
        "noNegationElse": "error",
        "noNestedTernary": "off",
        "noNonNullAssertion": "error",
        "noSubstr": "error",
        "noUselessElse": "error",
        "noYodaExpression": "error",
        "useAtIndex": "error",
        "useCollapsedElseIf": "error",
        "useCollapsedIf": "error",
        "useForOf": "error",
      },
      "suspicious": {
        "noAlert": "error",
        "noArrayIndexKey": "error",
        "noDuplicateTestHooks": "error",
        "noEmptyBlockStatements": "error",
        "noExplicitAny": "error",
        "noMisplacedAssertion": "error",
        "noSkippedTests": "error",
        "useErrorMessage": "error",
        "useNumberToFixedDigitsArgument": "error",
      },
      "security": {
        "noGlobalEval": "error",
      },
    },
  },
  "overrides": [
    {
      // Keep embedded HTML styles outside Biome's CSS formatting pass.
      "assist": {
        "actions": {
          "source": {
            "useSortedProperties": "off",
          },
        },
      },
      "formatter": {
        "enabled": false,
      },
      "includes": ["**/*.html"],
    },
    {
      // Generated by `mise run typegen`; must stay byte-identical to the
      // typegen output, so formatting and assist actions are disabled for these files.
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off",
            "useSortedAttributes": "off",
            "useSortedKeys": "off",
            "useSortedProperties": "off",
          },
        },
      },
      "formatter": {
        "enabled": false,
      },
      "includes": ["src/wasm/generated/**"],
    },
    {
      // Generated by `lingui compile`; must stay byte-identical to the Lingui
      // output, so formatting and assist actions are disabled for these files.
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off",
            "useSortedKeys": "off",
          },
        },
      },
      "formatter": {
        "enabled": false,
      },
      "includes": ["src/presentation/localization/locales/*.ts"],
    },
    {
      "includes": ["src/workers/shared/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noImplicitAnyLet": "error",
          },
        },
      },
    },
    {
      // Test helpers intentionally perform assertions on behalf of their caller's test case.
      "includes": ["tests/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noMisplacedAssertion": "off",
          },
        },
      },
    },
    {
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off",
          },
        },
      },
      "includes": ["**/*.json"],
    },
  ],
  "vcs": {
    "clientKind": "git",
    "defaultBranch": "main",
    "enabled": true,
    "useIgnoreFile": true,
  },
}
