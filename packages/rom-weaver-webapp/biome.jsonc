{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "root": true,
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedAttributes": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on",
      },
    },
    "enabled": true,
  },
  "files": {
    // Biome sorts CSS inside `<style>` blocks, but its HTML support is
    // experimental and the only HTML here is standalone prototype and matrix
    // pages that ship no styles to the app. An `overrides` entry does not
    // reach embedded CSS, so the exclusion has to live at this level.
    "includes": ["**", "!**/*.html"],
    "ignoreUnknown": true,
  },
  // Biome formats CSS only; oxfmt owns JS/TS/JSON. Disabling the other
  // languages here is what lets `npm run format:css` take a plain `.` path -
  // Biome ignores glob arguments, so the config is the only place the CSS
  // scope can be expressed.
  "css": {
    "formatter": {
      "enabled": true,
      "quoteStyle": "double",
    },
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 120,
  },
  "javascript": {
    "formatter": {
      "enabled": false,
    },
  },
  "json": {
    "formatter": {
      "enabled": false,
    },
  },
  "linter": {
    "domains": {
      "react": "recommended",
    },
    "enabled": true,
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn",
        "noForEach": "error",
        // CSS. Off because every `!important` in design-system/ is a
        // deliberate cascade escape with no alternative: the reduced-motion
        // resets must beat any author animation, the view-transition
        // suppression must beat an inline `style` attribute, the boot-shell
        // settle must reverse the layer order that puts phone-dock.css after
        // base.css, and the sample-tutorial classes are attached by JS to
        // whatever element the step happens to use, so no selector can be
        // written to outrank it. The layer hazard this rule would guard
        // against is already covered by `npm run lint:css-layers`.
        "noImportantStyles": "off",
        "noUselessStringConcat": "error",
        "useSimplifiedLogicExpression": "error",
      },
      "performance": {
        "useTopLevelRegex": "off",
      },
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "error",
      },
      "nursery": {
        "noDuplicateSelectors": "error",
      },
      "style": {
        "noCommonJs": "error",
        // CSS. Off because the rule pairs rules by their rightmost selector
        // alone, ignoring whether the ancestors can ever agree: every icon
        // rule ending in `svg` is reported against every other one, which is
        // 54 of the 72 findings here. Of the rest, the boot-shell overrides
        // and the `@media (pointer: coarse)` hint swap are deliberate and
        // documented in place. Ordering that actually decides a cascade
        // outcome is checked by `npm run lint:css-layers`.
        "noDescendingSpecificity": "off",
        "noNegationElse": "error",
        "noNestedTernary": "off",
        "noNonNullAssertion": "error",
        "noSubstr": "error",
        "noUselessElse": "error",
        "noYodaExpression": "error",
        "useAtIndex": "error",
        "useCollapsedElseIf": "error",
        "useCollapsedIf": "error",
        "useForOf": "error",
      },
      "suspicious": {
        "noAlert": "error",
        "noArrayIndexKey": "error",
        "noDuplicateTestHooks": "error",
        "noEmptyBlockStatements": "error",
        "noExplicitAny": "error",
        "noMisplacedAssertion": "error",
        "noSkippedTests": "error",
        "useErrorMessage": "error",
        "useNumberToFixedDigitsArgument": "error",
      },
      "security": {
        "noGlobalEval": "error",
      },
    },
  },
  "overrides": [
    {
      // Biome reaches CSS inside `<style>` blocks, but its HTML support is
      // experimental and these are standalone prototype and matrix pages that
      // ship no styles to the app. Keep the CSS pass on real .css files.
      "assist": {
        "actions": {
          "source": {
            "useSortedProperties": "off",
          },
        },
      },
      "formatter": {
        "enabled": false,
      },
      "includes": ["**/*.html"],
    },
    {
      // Generated by `mise run typegen`; must stay byte-identical to the
      // typegen output, so formatting and assist actions are disabled for these files.
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off",
            "useSortedAttributes": "off",
            "useSortedKeys": "off",
            "useSortedProperties": "off",
          },
        },
      },
      "formatter": {
        "enabled": false,
      },
      "includes": ["src/wasm/generated/**"],
    },
    {
      // Generated by `lingui compile`; must stay byte-identical to the Lingui
      // output, so formatting and assist actions are disabled for these files.
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off",
            "useSortedKeys": "off",
          },
        },
      },
      "formatter": {
        "enabled": false,
      },
      "includes": ["src/presentation/localization/locales/*.ts"],
    },
    {
      "includes": ["src/workers/shared/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noImplicitAnyLet": "error",
          },
        },
      },
    },
    {
      // Test helpers intentionally perform assertions on behalf of their caller's test case.
      "includes": ["tests/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noMisplacedAssertion": "off",
          },
        },
      },
    },
    {
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off",
          },
        },
      },
      "includes": ["**/*.json"],
    },
  ],
  "vcs": {
    "clientKind": "git",
    "defaultBranch": "main",
    "enabled": true,
    "useIgnoreFile": true,
  },
}
