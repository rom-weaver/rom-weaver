{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "incremental": true,
    "lib": ["dom", "dom.iterable", "webworker", "esnext"],
    "tsBuildInfoFile": "./dist/types/tsconfig.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "src/**/*.js", "src/**/*.jsx", "src/**/*.mjs"]
}
