{
  "cssCoverage": {
    "maxUnusedBytes": 52000
  },
  "lighthouse": {
    "runs": 3,
    "routes": [
      {
        "name": "Home",
        "path": "/"
      },
      {
        "name": "Apply",
        "path": "/apply-rom-patches/"
      },
      {
        "name": "Create",
        "path": "/create-rom-patch/"
      }
    ],
    "scores": {
      "performance": {
        "expected": 0.85,
        "minimum": 0.75
      },
      "accessibility": {
        "expected": 1,
        "minimum": 0.95
      },
      "best-practices": {
        "expected": 1,
        "minimum": 0.9
      },
      "seo": {
        "expected": 1,
        "minimum": 0.95
      }
    },
    "metrics": {
      "largest-contentful-paint": {
        "aggregation": "optimistic",
        "expected": 3500,
        "maximum": 5000,
        "unit": "ms"
      },
      "total-blocking-time": {
        "aggregation": "optimistic",
        "expected": 200,
        "maximum": 600,
        "unit": "ms"
      },
      "cumulative-layout-shift": {
        "expected": 0.1,
        "maximum": 0.25,
        "unit": ""
      }
    }
  }
}
